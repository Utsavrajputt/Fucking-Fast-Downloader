<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- libtorrent4j (magnet/torrent downloads) reads the Wi-Fi state to pick
         a network interface for its peer/DHT sockets. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Storage: legacy for Android 8-9, MANAGE_EXTERNAL_STORAGE for Android 10+ -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".FfApp"
        android:allowBackup="true"
        android:icon="@mipmap/xmd"
        android:roundIcon="@mipmap/xmd"
        android:label="@string/app_name"
        android:theme="@style/Theme.Xmd"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets browsers (Firefox, Vivaldi, etc.) offer xmd as an
                 "external download manager" / open-with target when a
                 download link is tapped. Firefox builds its download-manager
                 chooser by resolving which installed apps answer VIEW for the
                 link's scheme+mimeType, so both are needed: the scheme match
                 for the http(s) URL itself, and the wildcard mimeType so it
                 matches regardless of the file type being downloaded. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Covers "Share" -> xmd for a copied/shared link, which is how
                 Chrome, Samsung Internet, Edge, etc. hand a URL to another
                 app since they don't expose a download-manager chooser. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- magnet: links have no host/mimeType to match on, just the
                 scheme. This is what lets xmd show up when a magnet link is
                 tapped anywhere (a browser, a torrent-search app, another
                 file manager, etc). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- Direct .torrent file links/downloads (VIEW on the file's
                 content:// or the http(s) link itself, keyed off mimeType). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChallengeActivity"
            android:exported="false"
            android:label="@string/challenge_title" />

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
