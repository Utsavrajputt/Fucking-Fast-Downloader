<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ff_bg">

    <!-- Clipboard detection banner -->
    <LinearLayout
        android:id="@+id/clipboardBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ff_surface_2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_link"
            android:tint="@color/ff_accent"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/clipboardBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ff_text"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clipboardAddButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_add"
            android:textColor="@color/ff_accent"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />

        <ImageButton
            android:id="@+id/clipboardDismissButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_dismiss"
            android:src="@drawable/ic_close"
            android:tint="@color/ff_muted" />
    </LinearLayout>

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADD NEW DOWNLOAD"
                android:textColor="@color/ff_muted"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" />

            <!-- Input card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ff_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/ff_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- URL input row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="11dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_link"
                            android:tint="@color/ff_accent"
                            android:contentDescription="@null" />

                        <EditText
                            android:id="@+id/linksInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minLines="4"
                            android:maxLines="8"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:background="@null"
                            android:hint="@string/hint_links"
                            android:textColorHint="@color/ff_muted"
                            android:textColor="@color/ff_text"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ff_divider"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Action buttons row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <ImageButton
                            android:id="@+id/addTorrentButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_circle_outline"
                            android:padding="8dp"
                            android:src="@drawable/ic_magnet"
                            android:tint="@color/ff_accent"
                            android:contentDescription="@string/action_add_torrent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/prepareButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/action_prepare"
                            app:strokeColor="@color/ff_accent"
                            android:textColor="@color/ff_accent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/downloadButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_download"
                            app:backgroundTint="@color/ff_accent"
                            android:textColor="@color/ff_bg" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick stats (shows when downloads are active) -->
            <TextView
                android:id="@+id/quickStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/ff_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Empty hint -->
            <LinearLayout
                android:id="@+id/hintContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste links above to start downloading"
                    android:textColor="@color/ff_muted"
                    android:textSize="13sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Direct links · FuckingFast · Fitgirl Repacks"
                    android:textColor="@color/ff_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:alpha="0.55" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
